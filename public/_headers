# Cloudflare Pages headers.
# Hashed assets emitted by Astro into /_astro never change between
# deploys, so they can be cached immutably for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# HTML should always be revalidated so visitors get fresh content.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
