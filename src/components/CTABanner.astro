---
/**
 * CTABanner — reusable call-to-action strip placed near the
 * bottom of pages to drive membership enquiries.
 */
interface Props {
  heading?: string;
  text?: string;
  buttonLabel?: string;
  buttonHref?: string;
}

const {
  heading = 'Ready to get on the water?',
  text = 'Book a free taster session and our coaches will have you rowing in your first hour.',
  buttonLabel = 'Book a taster session',
  buttonHref = '/contact',
} = Astro.props;
---

<section class="bg-river-700">
  <div
    class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-4 py-14 text-center sm:px-6"
  >
    <h2 class="font-display text-2xl font-bold text-white sm:text-3xl">
      {heading}
    </h2>
    <p class="max-w-xl text-river-100">{text}</p>
    <a
      href={buttonHref}
      class="rounded-md bg-blade-400 px-7 py-3 text-base font-bold text-river-950 shadow-lg transition-transform hover:scale-[1.03] hover:bg-blade-300"
    >
      {buttonLabel}
    </a>
  </div>
</section>
