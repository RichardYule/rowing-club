---
/**
 * EventCard — renders one ClubEvent with a date badge,
 * category pill and location. Semantic <time> markup helps SEO.
 */
import { formatEventDate, type ClubEvent } from '../data/events';

interface Props {
  event: ClubEvent;
}

const { event } = Astro.props;

const categoryStyles: Record<ClubEvent['category'], string> = {
  Regatta: 'bg-gold-400/15 text-amber-700',
  Social: 'bg-rose-100 text-rose-700',
  Training: 'bg-royal-100 text-royal-800',
  Course: 'bg-emerald-100 text-emerald-800',
  Club: 'bg-slate-200 text-slate-700',
};

const day = new Date(event.date).getDate();
const month = new Intl.DateTimeFormat('en-GB', { month: 'short' }).format(
  new Date(event.date),
);
---

<article
  class="flex gap-5 rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition-shadow hover:shadow-md"
>
  <!-- Date badge -->
  <div
    class="flex h-16 w-16 shrink-0 flex-col items-center justify-center rounded-lg bg-royal-700 text-white"
  >
    <span class="font-display text-2xl font-extrabold leading-none">{day}</span>
    <span class="text-xs font-semibold uppercase tracking-wide">{month}</span>
  </div>

  <div class="min-w-0">
    <div class="flex flex-wrap items-center gap-2">
      <h3 class="font-display text-lg font-bold text-royal-950">
        {event.title}
      </h3>
      <span
        class={`rounded-full px-2.5 py-0.5 text-xs font-semibold ${categoryStyles[event.category]}`}
      >
        {event.category}
      </span>
    </div>
    <p class="mt-1 text-sm text-slate-500">
      <time datetime={event.date}>{formatEventDate(event.date)}</time>
       · {event.startTime} · {event.location}
    </p>
    <p class="mt-2 text-sm leading-relaxed text-slate-600">
      {event.description}
    </p>
  </div>
</article>
