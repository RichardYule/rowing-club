---
/**
 * FeatureCard — icon + title + text card used in feature grids.
 * The `icon` prop selects one of a few inline SVGs so we ship
 * zero icon-font or image requests.
 */
interface Props {
  title: string;
  text: string;
  icon: 'boat' | 'people' | 'trophy' | 'heart';
}

const { title, text, icon } = Astro.props;
---

<div
  class="group rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md"
>
  <div
    class="mb-4 inline-flex rounded-lg bg-royal-50 p-3 text-royal-700 transition-colors group-hover:bg-royal-100"
  >
    {
      icon === 'boat' && (
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 15h18l-2 4H5l-2-4Zm2-8 12 8M7 7l-2-2m2 2 2-2" />
        </svg>
      )
    }
    {
      icon === 'people' && (
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 19a4 4 0 0 0-8 0m8-10a4 4 0 1 1-8 0 4 4 0 0 1 8 0Zm5 10a5.5 5.5 0 0 0-3-4.6M3 19a5.5 5.5 0 0 1 3-4.6" />
        </svg>
      )
    }
    {
      icon === 'trophy' && (
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 21h8m-4-4v4m-6-17h12v4a6 6 0 0 1-12 0V4Zm12 2h3a2 2 0 0 1-2 4h-1M6 6H3a2 2 0 0 0 2 4h1" />
        </svg>
      )
    }
    {
      icon === 'heart' && (
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 20s-7-4.5-9-9a5 5 0 0 1 9-3 5 5 0 0 1 9 3c-2 4.5-9 9-9 9Z" />
        </svg>
      )
    }
  </div>
  <h3 class="font-display text-lg font-bold text-royal-950">{title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-slate-600">{text}</p>
</div>
