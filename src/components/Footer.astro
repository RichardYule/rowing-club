---
/**
 * Footer — contact details, quick links, utility pages, socials and
 * legal line. Rendered on every page by BaseLayout.
 *
 * "Support the club" gets a persistent highlighted slot here (per the IA:
 * /support/ is deliberately not in the primary nav).
 */
import { SITE, NAV_LINKS, UTILITY_LINKS } from '../consts';

const year = new Date().getFullYear();
---

<footer class="bg-royal-950 text-royal-100">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 sm:grid-cols-2 lg:grid-cols-4">
    <!-- Club identity -->
    <div>
      <p class="font-display text-xl font-bold text-white">{SITE.shortName}</p>
      <p class="mt-2 text-sm text-royal-300">{SITE.tagline}</p>
      <address class="mt-4 text-sm not-italic leading-relaxed text-royal-200">
        {SITE.address.street}<br />
        {SITE.address.city}, {SITE.address.postcode}<br />
        {SITE.address.country}
      </address>
    </div>

    <!-- Primary pages -->
    <nav aria-label="Footer navigation">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-royal-300">
        Explore
      </h2>
      <ul class="mt-3 space-y-2">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-royal-100 transition-colors hover:text-white">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Utility pages (footer-only, per the IA) -->
    <nav aria-label="Club pages">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-royal-300">
        The club
      </h2>
      <ul class="mt-3 space-y-2">
        {
          UTILITY_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  'text-sm transition-colors hover:text-white',
                  link.href === '/support' ? 'font-semibold text-gold-300' : 'text-royal-100',
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Contact + social -->
    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wider text-royal-300">
        Get in touch
      </h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li>
          <a href={`mailto:${SITE.email}`} class="transition-colors hover:text-white">
            {SITE.email}
          </a>
        </li>
        {
          SITE.phone && (
            <li>
              <a
                href={`tel:${SITE.phone.replace(/\s/g, '')}`}
                class="transition-colors hover:text-white"
              >
                {SITE.phone}
              </a>
            </li>
          )
        }
      </ul>
      <ul class="mt-4 flex gap-4">
        <li>
          <a href={SITE.social.instagram} class="text-royal-300 transition-colors hover:text-white" target="_blank" rel="noopener noreferrer">
            Instagram<span class="sr-only"> (opens in a new tab)</span>
          </a>
        </li>
        <li>
          <a href={SITE.social.facebook} class="text-royal-300 transition-colors hover:text-white" target="_blank" rel="noopener noreferrer">
            Facebook<span class="sr-only"> (opens in a new tab)</span>
          </a>
        </li>
        <li>
          <a href={SITE.social.twitter} class="text-royal-300 transition-colors hover:text-white" target="_blank" rel="noopener noreferrer">
            Twitter / X<span class="sr-only"> (opens in a new tab)</span>
          </a>
        </li>
      </ul>
    </div>
  </div>

  <!-- British Rowing affiliation — white band so the logo reads correctly -->
  <div class="bg-white">
    <div class="mx-auto flex max-w-6xl items-center justify-center px-4 py-6 sm:px-6">
      <img
        src="/images/brand/british-rowing-affiliated.svg"
        alt="British Rowing Affiliated Club"
        width="165"
        height="123"
        class="h-14 w-auto"
      />
    </div>
  </div>

  <div class="border-t border-royal-900">
    <p class="mx-auto max-w-6xl px-4 py-5 text-xs text-royal-400 sm:px-6">
      &copy; {year} {SITE.name}. All rights reserved.
    </p>
  </div>
</footer>