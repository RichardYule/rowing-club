---
/**
 * Header — sticky site header with responsive navigation.
 * Desktop: horizontal links. Mobile: hamburger toggling a menu.
 * The toggle uses a tiny inline script (progressive enhancement —
 * the links remain reachable without JS via the always-visible
 * desktop nav at >= md breakpoints).
 */
import { SITE, NAV_LINKS } from '../consts';

// Highlight the link matching the current page.
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';

const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-royal-100 bg-white/90 backdrop-blur">
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6"
    aria-label="Main navigation"
  >
    <!-- Club crest with name -->
    <a href="/" class="flex items-center" aria-label={`${SITE.name} — home`}>
      <img
        src="/images/brand/pcrc-crest-full.png"
        alt=""
        width="640"
        height="639"
        class="h-16 w-auto sm:h-20"
      />
    </a>

    <!-- Desktop nav -->
    <ul class="hidden items-center gap-1 md:flex">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={[
                'rounded-md px-3 py-2 text-sm font-medium transition-colors',
                isActive(link.href)
                  ? 'bg-royal-50 text-royal-800'
                  : 'text-slate-600 hover:bg-slate-50 hover:text-royal-700',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href="/membership"
          class="ml-2 rounded-md bg-royal-700 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-royal-800"
        >
          Join us
        </a>
      </li>
    </ul>

    <!-- Mobile menu button -->
    <button
      id="menu-toggle"
      type="button"
      class="inline-flex items-center justify-center rounded-md p-2 text-royal-800 hover:bg-royal-50 md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Toggle navigation menu"
    >
      <!-- Hamburger icon -->
      <svg id="icon-open" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <!-- Close icon (hidden until menu opens) -->
      <svg id="icon-close" class="hidden h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </nav>

  <!-- Mobile nav panel -->
  <div id="mobile-menu" class="hidden border-t border-royal-100 md:hidden">
    <ul class="space-y-1 px-4 py-3">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={[
                'block rounded-md px-3 py-2 text-base font-medium',
                isActive(link.href)
                  ? 'bg-royal-50 text-royal-800'
                  : 'text-slate-600 hover:bg-slate-50',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="pt-2">
        <a
          href="/membership"
          class="block rounded-md bg-royal-700 px-3 py-2.5 text-center text-base font-semibold text-white"
        >
          Join us
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  // Mobile menu toggle — runs client-side, keeps ARIA state in sync.
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
    iconOpen?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
  });
</script>
