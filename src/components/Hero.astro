---
/**
 * Hero — full-width banner for the home page.
 * Uses a pure-CSS gradient + SVG wave (no image downloads,
 * so it is fast and looks sharp on every screen density).
 */
import { SITE } from '../consts';

interface Props {
  title?: string;
  subtitle?: string;
}

const { title = SITE.name, subtitle = SITE.tagline } = Astro.props;
---

<section class="relative overflow-hidden bg-river-900 text-white">
  <!-- Decorative gradient wash -->
  <div
    class="absolute inset-0 bg-gradient-to-br from-river-800 via-river-900 to-river-950"
    aria-hidden="true"
  >
  </div>

  <!-- Decorative oar strokes -->
  <svg
    class="absolute inset-x-0 bottom-0 h-32 w-full text-river-500/30 sm:h-44"
    viewBox="0 0 1440 160"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path
      d="M0 96c120-32 240-32 360 0s240 32 360 0 240-32 360 0 240 32 360 0v64H0z"
      fill="currentColor"></path>
    <path
      d="M0 128c120-24 240-24 360 0s240 24 360 0 240-24 360 0 240 24 360 0v32H0z"
      fill="currentColor"
      opacity="0.6"></path>
  </svg>

  <div
    class="relative mx-auto flex max-w-6xl flex-col items-center px-4 py-24 text-center sm:px-6 sm:py-32 lg:py-40"
  >
    <p
      class="mb-4 inline-block rounded-full border border-river-400/40 bg-river-800/60 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.2em] text-river-200"
    >
      Est. {SITE.founded} · River Thames
    </p>
    <h1
      class="font-display text-4xl font-extrabold tracking-tight sm:text-6xl lg:text-7xl"
    >
      {title}
    </h1>
    <p class="mt-5 max-w-2xl text-lg text-river-100 sm:text-xl">
      {subtitle}
    </p>
    <div class="mt-9 flex flex-col gap-3 sm:flex-row">
      <a
        href="/membership"
        class="rounded-md bg-blade-400 px-7 py-3 text-base font-bold text-river-950 shadow-lg transition-transform hover:scale-[1.03] hover:bg-blade-300"
      >
        Start rowing
      </a>
      <a
        href="/about"
        class="rounded-md border border-river-300/50 px-7 py-3 text-base font-semibold text-river-100 transition-colors hover:bg-river-800"
      >
        Discover the club
      </a>
    </div>
  </div>
</section>
