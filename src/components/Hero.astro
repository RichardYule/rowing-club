---
/**
 * Hero — full-width photo banner for the home page.
 * The photo is the LCP element: it loads eagerly with fetchpriority=high,
 * and the copy sits on a royal-blue scrim so the text is readable on any crop.
 */
import { SITE } from '../consts';
import SitePicture from './SitePicture.astro';
import heroImage from '../assets/images/hero-lake-racing.jpg';

interface Props {
  title?: string;
  subtitle?: string;
}

const { title = SITE.name, subtitle = SITE.tagline } = Astro.props;
---

<section class="relative overflow-hidden bg-royal-950 text-white">
  <!-- Background photo (eager: this is the largest contentful paint) -->
  <div class="absolute inset-0" aria-hidden="true">
    <SitePicture
      src={heroImage}
      alt=""
      priority
      sizes="100vw"
      widths={[768, 1200, 1600]}
      class="h-full w-full object-cover"
    />
  </div>

  <!-- Royal scrim keeps text readable on any photo -->
  <div
    class="absolute inset-0 bg-gradient-to-b from-royal-950/80 via-royal-900/60 to-royal-950/80"
    aria-hidden="true"
  >
  </div>

  <div
    class="relative mx-auto flex max-w-6xl flex-col items-center px-4 py-24 text-center sm:px-6 sm:py-32 lg:py-40"
  >
    <p
      class="mb-4 inline-block rounded-full border border-gold-400/50 bg-royal-950/60 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.2em] text-gold-300"
    >
      Est. {SITE.founded} · Thorpe Meadows, Peterborough
    </p>
    <h1
      class="font-display text-4xl font-extrabold tracking-tight sm:text-6xl lg:text-7xl"
    >
      {title}
    </h1>
    <p class="mt-5 max-w-2xl text-lg text-royal-100 sm:text-xl">
      {subtitle}
    </p>
    <div class="mt-9 flex flex-col gap-3 sm:flex-row">
      <a
        href="/membership"
        class="rounded-md bg-gold-400 px-7 py-3 text-base font-bold text-royal-950 shadow-lg transition-transform hover:scale-[1.03] hover:bg-gold-300"
      >
        Start rowing
      </a>
      <a
        href="/about"
        class="rounded-md border border-royal-100/60 bg-royal-950/40 px-7 py-3 text-base font-semibold text-royal-50 transition-colors hover:bg-royal-900/60"
      >
        Discover the club
      </a>
    </div>
  </div>
</section>
