---
/**
 * SectionHeading — consistent eyebrow + title + intro pattern
 * used at the top of page sections.
 */
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, intro, align = 'center' } = Astro.props;
const alignClass = align === 'center' ? 'items-center text-center' : 'items-start text-left';
---

<div class={`flex flex-col gap-3 ${alignClass}`}>
  {
    eyebrow && (
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-river-600">
        {eyebrow}
      </p>
    )
  }
  <h2 class="font-display text-3xl font-bold tracking-tight text-river-950 sm:text-4xl">
    {title}
  </h2>
  {intro && <p class="max-w-2xl text-lg text-slate-600">{intro}</p>}
</div>
