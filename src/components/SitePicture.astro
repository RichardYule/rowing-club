---
/**
 * SitePicture — the standard way to render a photo on the site.
 *
 * Wraps astro:assets <Picture> with the house rules (see docs/photos.md):
 * AVIF + WebP variants generated at build, responsive widths, lazy loading
 * with intrinsic dimensions (no layout shift). Visual crops are done with
 * CSS (aspect-* + object-cover) passed via `class`.
 *
 * Set `priority` ONLY on the one above-the-fold hero image per page.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** CSS sizes hint, e.g. '100vw' or '(min-width: 1024px) 50vw, 100vw' */
  sizes?: string;
  /** Eager-load with fetchpriority=high — for the LCP hero only */
  priority?: boolean;
  class?: string;
  widths?: number[];
}

const {
  src,
  alt,
  sizes = '100vw',
  priority = false,
  class: className,
  widths = [480, 768, 1200],
} = Astro.props;

// Never upscale: srcset widths capped at the source's intrinsic width.
// (If every requested width is smaller than the source, that's fine —
// the browser lightly upscales the largest variant, which is the
// standard trade-off for keeping files small.)
const usable = widths.filter((w) => w <= src.width);
---

<Picture
  src={src}
  alt={alt}
  formats={['avif', 'webp']}
  widths={usable}
  sizes={sizes}
  quality={50}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : undefined}
  decoding="async"
  class={className}
/>
