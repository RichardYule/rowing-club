---
/**
 * BaseLayout — the HTML shell shared by every page.
 * Pages supply a title/description via props and inject their
 * content into the default <slot />.
 */
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import montserrat700Url from '../assets/fonts/montserrat-700.woff2?url';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  index?: boolean;
}

const { title, description, image, index } = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Preload the hero font so it starts downloading before CSS parse -->
    <link rel="preload" href={montserrat700Url} as="font" type="font/woff2" crossorigin />

    <SEO title={title} description={description} image={image} index={index} />
  </head>
  <body class="flex min-h-screen flex-col">
    <!-- Skip link: first focusable element for keyboard/screen-reader users -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-royal-700 focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to main content
    </a>

    <Header />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
