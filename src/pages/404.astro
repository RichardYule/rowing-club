---
/**
 * Custom 404 page. Marked noindex so search engines don't list it.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" index={false}>
  <section
    class="mx-auto flex max-w-2xl flex-col items-center px-4 py-28 text-center sm:px-6"
  >
    <p class="font-display text-7xl font-extrabold text-river-200">404</p>
    <h1 class="mt-4 font-display text-3xl font-bold text-river-950">
      You've caught a crab
    </h1>
    <p class="mt-3 text-lg text-slate-600">
      The page you're looking for has drifted off course. Let's get you back
      to the boathouse.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a
        href="/"
        class="rounded-md bg-river-700 px-6 py-3 text-sm font-bold text-white transition-colors hover:bg-river-800"
      >
        Back to home
      </a>
      <a
        href="/contact"
        class="rounded-md border border-slate-300 px-6 py-3 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-50"
      >
        Contact us
      </a>
    </div>
  </section>
</BaseLayout>
