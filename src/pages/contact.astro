---
/**
 * Contact — the consolidated enquiry form (one form with topic routing
 * replaces the old site's four separate forms), key contacts, and
 * directions to Thorpe Meadows.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { contacts } from '../data/contacts';
import { SITE } from '../consts';
---

<BaseLayout
  title="Contact"
  description="Contact Peterborough City Rowing Club — joining, learn-to-row courses, volunteering, sponsorship, press and lake hire."
>
  <section class="bg-royal-50">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <SectionHeading
        eyebrow="Contact"
        title="Say hello"
        intro="One form, whatever your question — pick a topic and it goes straight to the right person. We reply within a couple of days."
      />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="grid gap-12 lg:grid-cols-5">
      <!-- Consolidated enquiry form -->
      <div class="lg:col-span-3">
        <h2 class="font-display text-xl font-bold text-royal-950">
          Send us a message
        </h2>
        <div class="mt-6">
          <EnquiryForm />
        </div>
      </div>

      <!-- Visit info -->
      <aside class="lg:col-span-2">
        <h2 class="font-display text-xl font-bold text-royal-950">Visit us</h2>
        <dl class="mt-6 space-y-5 text-sm">
          <div>
            <dt class="font-semibold text-slate-700">The Boathouse</dt>
            <dd class="mt-1 leading-relaxed text-slate-600">
              {SITE.address.street}<br />
              {SITE.address.city}, {SITE.address.postcode}
            </dd>
          </div>
          <div>
            <dt class="font-semibold text-slate-700">Email</dt>
            <dd class="mt-1">
              <a
                href={`mailto:${SITE.email}`}
                class="text-royal-700 underline-offset-4 hover:underline"
              >
                {SITE.email}
              </a>
            </dd>
          </div>
          {
            SITE.phone && (
              <div>
                <dt class="font-semibold text-slate-700">Phone</dt>
                <dd class="mt-1">
                  <a
                    href={`tel:${SITE.phone.replace(/\s/g, '')}`}
                    class="text-royal-700 underline-offset-4 hover:underline"
                  >
                    {SITE.phone}
                  </a>
                </dd>
              </div>
            )
          }
          <div>
            <dt class="font-semibold text-slate-700">Getting here</dt>
            <dd class="mt-1 leading-relaxed text-slate-600">
              Thorpe Meadows is signposted from the Nene Parkway (A1260),
              beside Nene Park. Parking is on site; the boathouse is a short
              walk along the lake from the car park.
            </dd>
          </div>
          <div>
            <dt class="font-semibold text-slate-700">Best time to visit</dt>
            <dd class="mt-1 leading-relaxed text-slate-600">
              Saturday mornings, when most squads are on the water and the
              clubhouse is open.
            </dd>
          </div>
        </dl>

        <!-- Stylised map placeholder -->
        <div
          class="mt-8 flex h-52 items-center justify-center rounded-xl bg-royal-900 text-royal-200"
          role="img"
          aria-label="Stylised map showing the boathouse on the lake at Thorpe Meadows"
        >
          <svg class="h-full w-full" viewBox="0 0 400 200" aria-hidden="true">
            <rect width="400" height="200" class="fill-royal-900"></rect>
            <path
              d="M0 120c60-25 120-25 180 0s120 25 220-10v90H0z"
              class="fill-royal-700"></path>
            <path
              d="M0 135c60-20 120-20 180 0s120 20 220-8"
              fill="none"
              class="stroke-royal-300"
              stroke-width="2"
              stroke-dasharray="6 6"></path>
            <circle cx="200" cy="95" r="9" class="fill-gold-400"></circle>
            <circle cx="200" cy="95" r="16" class="fill-gold-400/30"></circle>
            <text x="200" y="70" text-anchor="middle" class="fill-white text-[13px] font-semibold">
              Thorpe Meadows
            </text>
          </svg>
        </div>
      </aside>
    </div>

    <!-- Key contacts directory -->
    <div class="mt-20">
      <h2 class="font-display text-xl font-bold text-royal-950">Key contacts</h2>
      <p class="mt-2 max-w-2xl text-sm text-slate-600">
        Prefer to go straight to the person responsible? Role inboxes are
        checked by the relevant committee member.
      </p>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          contacts.map((contact) => (
            <li class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
              <p class="font-semibold text-royal-950">
                {contact.role}
                {contact.name && <span class="font-normal text-slate-500"> · {contact.name}</span>}
              </p>
              <a
                href={`mailto:${contact.email}`}
                class="mt-1 block break-all text-sm text-royal-700 underline-offset-4 hover:underline"
              >
                {contact.email}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
