---
/**
 * Home page — hero, club highlights, upcoming events preview
 * and a call to action.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FeatureCard from '../components/FeatureCard.astro';
import EventCard from '../components/EventCard.astro';
import CTABanner from '../components/CTABanner.astro';
import { events } from '../data/events';
import { SITE } from '../consts';

// Show the next three events (data is pre-sorted by date).
const upcoming = [...events]
  .sort((a, b) => a.date.localeCompare(b.date))
  .slice(0, 3);
---

<BaseLayout title={SITE.name}>
  <Hero />

  <!-- Why row with us -->
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6" aria-labelledby="why-us">
    <SectionHeading
      eyebrow="Why Tideway"
      title="A club for every rower"
      intro="From your first strokes to national regattas, our volunteer coaches and modern fleet support rowers of every age and ambition."
    />
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <FeatureCard
        icon="boat"
        title="Modern fleet"
        text="Racing shells from singles to eights, plus stable training boats for beginners, all maintained by our boatman."
      />
      <FeatureCard
        icon="people"
        title="Expert coaching"
        text="Level 2+ volunteer coaches run structured squads for juniors, seniors, masters and complete novices."
      />
      <FeatureCard
        icon="trophy"
        title="Racing calendar"
        text="We compete at heads and regattas across the country, from local matches to Henley Royal Regatta qualifiers."
      />
      <FeatureCard
        icon="heart"
        title="Welcoming community"
        text="Social rows, club suppers and a thriving volunteer scene — rowing is the excuse, the people are the reason."
      />
    </div>
  </section>

  <!-- Stats strip -->
  <section class="bg-river-50" aria-label="Club statistics">
    <dl
      class="mx-auto grid max-w-6xl grid-cols-2 gap-8 px-4 py-14 text-center sm:px-6 lg:grid-cols-4"
    >
      <div>
        <dt class="sr-only">Years on the river</dt>
        <dd class="font-display text-4xl font-extrabold text-river-800">134</dd>
        <dd class="mt-1 text-sm font-medium text-slate-600">Years on the river</dd>
      </div>
      <div>
        <dt class="sr-only">Active members</dt>
        <dd class="font-display text-4xl font-extrabold text-river-800">260+</dd>
        <dd class="mt-1 text-sm font-medium text-slate-600">Active members</dd>
      </div>
      <div>
        <dt class="sr-only">Boats in the fleet</dt>
        <dd class="font-display text-4xl font-extrabold text-river-800">48</dd>
        <dd class="mt-1 text-sm font-medium text-slate-600">Boats in the fleet</dd>
      </div>
      <div>
        <dt class="sr-only">Pots won last season</dt>
        <dd class="font-display text-4xl font-extrabold text-river-800">31</dd>
        <dd class="mt-1 text-sm font-medium text-slate-600">Pots won last season</dd>
      </div>
    </dl>
  </section>

  <!-- Upcoming events preview -->
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6" aria-labelledby="upcoming-events">
    <SectionHeading
      eyebrow="What's on"
      title="Upcoming events"
      intro="Regattas, courses and socials — there's always something happening at the club."
    />
    <div class="mt-12 grid gap-5 lg:grid-cols-1">
      {upcoming.map((event) => <EventCard event={event} />)}
    </div>
    <p class="mt-8 text-center">
      <a
        href="/events"
        class="font-semibold text-river-700 underline-offset-4 hover:underline"
      >
        View the full calendar &rarr;
      </a>
    </p>
  </section>

  <CTABanner />
</BaseLayout>
