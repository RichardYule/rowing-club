---
/**
 * Membership — the site's main conversion page: fees, how joining works,
 * and the kit section (#kit). All join paths funnel to the consolidated
 * enquiry form with the right topic pre-selected.
 *
 * Per club decision there is NO social membership tier on this page.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import MembershipTierCard from '../components/MembershipTierCard.astro';
import CTABanner from '../components/CTABanner.astro';
import SitePicture from '../components/SitePicture.astro';
import { membershipTiers } from '../data/membership';
import kitImg from '../assets/images/membership-kit-all-in-one.png';
---

<BaseLayout
  title="Membership"
  description="Join Peterborough City Rowing Club — Learn to Row courses, senior and junior membership on the lake at Thorpe Meadows."
>
  <section class="bg-royal-50">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <SectionHeading
        eyebrow="Membership"
        title="Find your seat in the boat"
        intro="Simple fees, no long contracts. Every rowing journey here starts with one message."
      />
    </div>
  </section>

  <!-- Pricing tiers -->
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6" aria-label="Membership pricing">
    <div class="grid items-stretch gap-8 pt-4 lg:grid-cols-3">
      {membershipTiers.map((tier) => <MembershipTierCard tier={tier} />)}
    </div>
    <p class="mt-8 text-center text-sm text-slate-600">
      Coxswains, students and families — ask about our other rates. Racking a
      private boat is priced separately.
    </p>
  </section>

  <!-- How joining works -->
  <section class="border-t border-slate-100 bg-royal-50/60">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
      <h2 class="font-display text-2xl font-bold text-royal-950">How joining works</h2>
      <ol class="mt-8 space-y-6">
        <li class="flex gap-5">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-royal-700 font-display text-lg font-bold text-white" aria-hidden="true">1</span>
          <div>
            <h3 class="font-display text-lg font-bold text-royal-950">Send us a message</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-slate-600">
              Tell us your experience (none is fine) and which squad you're
              interested in. The Membership Secretary replies within a couple
              of days.
            </p>
          </div>
        </li>
        <li class="flex gap-5">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-royal-700 font-display text-lg font-bold text-white" aria-hidden="true">2</span>
          <div>
            <h3 class="font-display text-lg font-bold text-royal-950">Come and try a session</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-slate-600">
              Experienced rowers join a squad outing to find the right crew;
              complete beginners book onto the next Learn to Row course.
            </p>
          </div>
        </li>
        <li class="flex gap-5">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-royal-700 font-display text-lg font-bold text-white" aria-hidden="true">3</span>
          <div>
            <h3 class="font-display text-lg font-bold text-royal-950">Sign up and row</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-slate-600">
              Membership runs monthly with no minimum term. We'll add you to
              the squad groups so you hear about sessions, racing and socials.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- Kit & clothing -->
  <section id="kit" class="scroll-mt-20 border-t border-slate-100">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <div class="grid items-center gap-8 lg:grid-cols-2">
        <div>
          <h2 class="font-display text-2xl font-bold text-royal-950">Kit & clothing</h2>
          <div class="mt-5 space-y-4 leading-relaxed text-slate-700">
            <p>
              To race for PCRC you'll need the club racing kit — an all-in-one in
              club colours, ordered through the Kit Secretary a couple of times a
              year. Off the water there's club hoodies, t-shirts and jackets.
            </p>
            <p>
              New to rowing? Don't buy anything yet: training kit is just
              close-fitting sports kit and old trainers. Everything else is
              explained on your course.
            </p>
          </div>
        </div>
        <SitePicture
          src={kitImg}
          alt="The PCRC racing all-in-one in royal blue and old gold"
          sizes="(min-width: 1024px) 40vw, 80vw"
          widths={[480]}
          class="mx-auto w-full max-w-xs rounded-xl bg-royal-50 p-6"
        />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-slate-100 bg-royal-50/60" aria-labelledby="faq">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
      <SectionHeading
        eyebrow="Questions"
        title="Frequently asked questions"
      />
      <div class="mt-10 space-y-3">
        <details class="group rounded-lg border border-slate-200 bg-white p-5 open:shadow-sm">
          <summary class="cursor-pointer list-none font-semibold text-royal-950 marker:hidden">
            Do I need any experience to join?
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">
            None at all. Our Learn to Row course assumes you have never sat in a
            boat. If you have rowed before, come to a squad session and a coach
            will help you find the right crew.
          </p>
        </details>
        <details class="group rounded-lg border border-slate-200 bg-white p-5 open:shadow-sm">
          <summary class="cursor-pointer list-none font-semibold text-royal-950 marker:hidden">
            Do I need to be able to swim?
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">
            Yes — for safety we ask that all members can swim 50 metres in
            clothing. Capsize awareness is part of every beginner course, and
            safety launches accompany novice outings.
          </p>
        </details>
        <details class="group rounded-lg border border-slate-200 bg-white p-5 open:shadow-sm">
          <summary class="cursor-pointer list-none font-semibold text-royal-950 marker:hidden">
            What should I wear?
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">
            Close-fitting sports kit and trainers you don't mind getting wet.
            Avoid baggy tops (they catch in the slide) and bring layers in
            winter.
          </p>
        </details>
        <details class="group rounded-lg border border-slate-200 bg-white p-5 open:shadow-sm">
          <summary class="cursor-pointer list-none font-semibold text-royal-950 marker:hidden">
            Can I pause or cancel my membership?
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">
            Any time. Memberships are rolling monthly with no minimum term, and
            we happily pause for injury, exams or extended travel.
          </p>
        </details>
      </div>
    </div>
  </section>

  <CTABanner
    heading="Ready to start?"
    text="One message is all it takes — tell us a bit about yourself and we'll take it from there."
    buttonLabel="Enquire about joining"
    buttonHref="/contact/?topic=join"
  />
</BaseLayout>
